# ==========================================================
# Federal University Otuoke - Admission System Environment
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# Flask core
# Use app.py for local development. Switch to wsgi.py for production deployment.
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-64-character-string

# Database
# For local development with zero setup, use SQLite (default below).
DB_ENGINE=sqlite

# When you're ready to move to MySQL (e.g. for deployment), switch to:
# DB_ENGINE=mysql+pymysql
# DB_USER=admission_user
# DB_PASSWORD=change-this-password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=fuo_admission_system

# Mail (for password reset / notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=admissions@fuotuoke.edu.ng

# Application
# LOCAL DEV: http://127.0.0.1:5000   |   PRODUCTION: https://admissions.fuotuoke.edu.ng
APP_BASE_URL=https://admissions.fuotuoke.edu.ng
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=5
SESSION_TIMEOUT_MINUTES=30

# Security
WTF_CSRF_TIME_LIMIT=3600
BCRYPT_LOG_ROUNDS=12

# Current admission session (used as default when creating new applications)
CURRENT_ACADEMIC_SESSION=2025/2026
